# Maintainer: Kitsune Player Team <team@auralune.org>
pkgname=auralune
pkgver=2.1.1
pkgrel=1
pkgdesc="Native music player for Linux (Poweramp + foobar2000 + anime aesthetic + real-time DSP)"
arch=('x86_64')
url="https://github.com/Das-Letzte-Kemonomimi/Aura-Lune"
license=('GPL-3.0-or-later')
depends=(
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'pipewire'
    'sqlite'
    'webkit2gtk-4.1'
    'gtk3'
    'glib2'
    'cairo'
    'pango'
    'openssl'
)
optdepends=(
    'gst-plugins-bad: Support for Opus, AAC, and modern container formats'
    'gst-plugin-pipewire: Direct low-latency PipeWire output sink'
    'rubberband: High-quality studio time-stretching and pitch-shifting DSP engine'
    'soundtouch: Low CPU overhead DSP engine with independent tempo/pitch shifting'
    'bluez-utils: Dynamic pro-audio Bluetooth codec switching (LDAC, aptX HD, AAC, SBC-XQ)'
    'onnxruntime: akceleracja modeli uczenia maszynowego (Music Analysis & Stem Separation)'
)
makedepends=(
    'cargo'
    'rust'
    'nodejs'
    'npm'
    'pkgconf'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver" || cd "$srcdir/Auralune-$pkgver" || return 0
    npm ci
}

build() {
    cd "$srcdir/$pkgname-$pkgver" || cd "$srcdir/Auralune-$pkgver" || return 0
    
    # Build the app in release mode with the bundled frontend
    npx tauri build --no-bundle
}

package() {
    cd "$srcdir/$pkgname-$pkgver" || cd "$srcdir/Auralune-$pkgver" || return 0

    # Binary
    install -Dm755 "target/release/auralune-desktop" "$pkgdir/usr/bin/auralune"

    # Desktop entry (.desktop)
    install -Dm644 "packaging/auralune.desktop" "$pkgdir/usr/share/applications/auralune.desktop"

    # System icons in every standard hicolor size, plus pixmaps
    install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/auralune.png"
    install -Dm644 "src-tauri/icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/auralune.png"
    install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/auralune.png"
    install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/auralune.png"
    install -Dm644 "src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/auralune.png"
    install -Dm644 "public/auralune_icon.png" "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/auralune.png"
    install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/pixmaps/auralune.png"

    # License
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
