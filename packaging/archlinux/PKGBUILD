# Maintainer: Kitsune Player Team <team@auralune.org>
pkgname=auralune
pkgver=0.2.2
pkgrel=1
pkgdesc="Natywny odtwarzacz muzyki dla Linuksa (Poweramp + foobar2000 + anime aesthetic + real-time DSP)"
arch=('x86_64')
url="https://github.com/Das-Letzte-Kemonomimi/Aura-Lune"
license=('GPL-3.0-or-later')
depends=(
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'pipewire'
    'sqlite'
    'webkit2gtk-4.1'
    'gtk3'
    'glib2'
    'cairo'
    'pango'
    'openssl'
)
optdepends=(
    'gst-plugins-bad: obsługa formatów Opus, AAC i zaawansowanych kontenerów'
    'gst-plugin-pipewire: bezpośredni potok wyjściowy PipeWire o niskiej latencji'
    'rubberband: silnik DSP time-stretching i pitch-shifting wysokiej jakości'
    'soundtouch: silnik DSP o niskim narzucie CPU i niezależnej zmianie tempa/wysokości'
    'bluez-utils: dynamiczny wybór kodeków Bluetooth (LDAC, aptX HD, AAC, SBC-XQ)'
)
makedepends=(
    'cargo'
    'rust'
    'nodejs'
    'npm'
    'pkgconf'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver" || cd "$srcdir/Auralune-$pkgver" || return 0
    cd apps/desktop
    npm ci
}

build() {
    cd "$srcdir/$pkgname-$pkgver" || cd "$srcdir/Auralune-$pkgver" || return 0
    
    # Budowanie aplikacji w trybie release z wbudowanym frontendem
    cd apps/desktop
    npx tauri build --no-bundle
    cd ../..
}

package() {
    cd "$srcdir/$pkgname-$pkgver" || cd "$srcdir/Auralune-$pkgver" || return 0

    # Binarka
    install -Dm755 "target/release/auralune-desktop" "$pkgdir/usr/bin/auralune"

    # Plik aktywatora pulpitu .desktop
    install -Dm644 "packaging/auralune.desktop" "$pkgdir/usr/share/applications/auralune.desktop"

    # Ikony systemowe we wszystkich standardowych rozdzielczościach hicolor oraz pixmaps
    install -Dm644 "apps/desktop/src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/auralune.png"
    install -Dm644 "apps/desktop/src-tauri/icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/auralune.png"
    install -Dm644 "apps/desktop/src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/auralune.png"
    install -Dm644 "apps/desktop/src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/auralune.png"
    install -Dm644 "apps/desktop/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/auralune.png"
    install -Dm644 "apps/desktop/public/auralune_icon.png" "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/auralune.png"
    install -Dm644 "apps/desktop/src-tauri/icons/128x128.png" "$pkgdir/usr/share/pixmaps/auralune.png"

    # Licencja
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
