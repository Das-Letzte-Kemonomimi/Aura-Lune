# Maintainer: Kitsune Player Team <team@auralune.org>
pkgname=auralune-bin
pkgver=2.1.1
pkgrel=1

pkgdesc="Native music player for Linux (Poweramp + foobar2000 + anime aesthetic + real-time DSP) - binary AppImage package"
arch=('x86_64')
url="https://github.com/Das-Letzte-Kemonomimi/Aura-Lune"
license=('GPL-3.0-or-later')
provides=('auralune')
conflicts=('auralune' 'auralune-git')
depends=(
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'pipewire'
    'sqlite'
    'webkit2gtk-4.1'
    'gtk3'
    'glib2'
    'cairo'
    'pango'
    'openssl'
)
optdepends=(
    'gst-plugins-bad: Support for Opus, AAC, and modern container formats'
    'gst-plugin-pipewire: Direct low-latency PipeWire output sink'
    'rubberband: High-quality studio time-stretching and pitch-shifting DSP engine'
    'soundtouch: Low CPU overhead DSP engine with independent tempo/pitch shifting'
    'bluez-utils: Dynamic pro-audio Bluetooth codec switching (LDAC, aptX HD, AAC, SBC-XQ)'
    'onnxruntime: Hardware-accelerated AI models for deep learning stem separation and music analysis'
)
options=('!strip')
source=("$pkgname-$pkgver.AppImage::$url/releases/download/v$pkgver/Auralune_${pkgver}_amd64.AppImage")
sha256sums=('e4892bba6e8ee0f36331062b84f4726aebb60f956098dbe8cf4021025378d467')




prepare() {
    chmod +x "$pkgname-$pkgver.AppImage"
    ./"$pkgname-$pkgver.AppImage" --appimage-extract > /dev/null
}

package() {
    cd "$srcdir/squashfs-root"

    # The whole AppImage (with its bundled libraries: RubberBand, SoundTouch, GStreamer, GTK…)
    # goes to /opt/auralune. The app then does not depend on the system library versions
    # (the CI AppImage is built on Ubuntu), and `pacman -R` uninstalls everything.
    install -dm755 "$pkgdir/opt/auralune"
    cp -a --no-preserve=ownership . "$pkgdir/opt/auralune/"
    chmod -R u+w,go+rX "$pkgdir/opt/auralune"

    # AppRun derives its directory from $0, so a symlink won't work: a launcher script is needed.
    install -dm755 "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec /opt/auralune/AppRun "$@"\n' > "$pkgdir/usr/bin/auralune"
    chmod 755 "$pkgdir/usr/bin/auralune"

    # Our own .desktop file (the one in the AppImage has Exec=auralune-desktop, which is not in PATH).
    install -dm755 "$pkgdir/usr/share/applications"
    cat > "$pkgdir/usr/share/applications/auralune.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Auralune
GenericName=Music Player
GenericName[pl]=Odtwarzacz muzyki
Comment=Poweramp & foobar2000 inspired Linux music player with anime aesthetics and real-time DSP
Comment[pl]=Inspirowany Powerampem i foobar2000 odtwarzacz muzyki dla Linuksa z estetyką anime i silnikiem DSP
Exec=auralune %U
Icon=auralune
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
MimeType=audio/flac;audio/mpeg;audio/ogg;audio/opus;audio/x-wav;audio/aac;audio/m4a;audio/x-m4a;
StartupNotify=true
StartupWMClass=auralune-desktop
Keywords=audio;music;player;dsp;soundtouch;rubberband;mpris;pipewire;
DESKTOP

    # hicolor icons under the name `auralune` (matching Icon= above), plus pixmaps.
    local size
    for size in 32x32 64x64 128x128 256x256 512x512; do
        if [ -f "usr/share/icons/hicolor/$size/apps/auralune-desktop.png" ]; then
            install -Dm644 "usr/share/icons/hicolor/$size/apps/auralune-desktop.png" \
                "$pkgdir/usr/share/icons/hicolor/$size/apps/auralune.png"
        fi
    done
    install -Dm644 Auralune.png "$pkgdir/usr/share/pixmaps/auralune.png"
}
