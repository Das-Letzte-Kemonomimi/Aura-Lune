# Maintainer: Kitsune Player Team <team@auralune.org>
pkgname=auralune-bin
pkgver=0.6.4
pkgrel=1

pkgdesc="Native music player for Linux (Poweramp + foobar2000 + anime aesthetic + real-time DSP) - binary AppImage package"
arch=('x86_64')
url="https://github.com/Das-Letzte-Kemonomimi/Aura-Lune"
license=('GPL-3.0-or-later')
provides=('auralune')
conflicts=('auralune' 'auralune-git')
depends=(
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'pipewire'
    'sqlite'
    'webkit2gtk-4.1'
    'gtk3'
    'glib2'
    'cairo'
    'pango'
    'openssl'
)
optdepends=(
    'gst-plugins-bad: Support for Opus, AAC, and modern container formats'
    'gst-plugin-pipewire: Direct low-latency PipeWire output sink'
    'rubberband: High-quality studio time-stretching and pitch-shifting DSP engine'
    'soundtouch: Low CPU overhead DSP engine with independent tempo/pitch shifting'
    'bluez-utils: Dynamic pro-audio Bluetooth codec switching (LDAC, aptX HD, AAC, SBC-XQ)'
)
options=('!strip')
source=("$pkgname-$pkgver.AppImage::$url/releases/download/v$pkgver/Auralune_${pkgver}_amd64.AppImage")
sha256sums=('8df4deea3bb6ea88b333e3bb0c7ff287f0c8945ee5f88dad556bd39b04a9ac32')




prepare() {
    chmod +x "$pkgname-$pkgver.AppImage"
    ./"$pkgname-$pkgver.AppImage" --appimage-extract > /dev/null
}

package() {
    cd "$srcdir/squashfs-root"

    # Główna binarka
    install -Dm755 usr/bin/auralune-desktop "$pkgdir/usr/bin/auralune"

    # Plik aktywatora pulpitu .desktop
    install -Dm644 Auralune.desktop "$pkgdir/usr/share/applications/auralune.desktop"

    # Ikony we wszystkich standardowych rozdzielczościach hicolor oraz pixmaps
    install -Dm644 usr/share/icons/hicolor/32x32/apps/auralune-desktop.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/auralune.png" 2>/dev/null || true
    install -Dm644 usr/share/icons/hicolor/128x128/apps/auralune-desktop.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/auralune.png" 2>/dev/null || true
    install -Dm644 usr/share/icons/hicolor/256x256/apps/auralune-desktop.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/auralune.png" 2>/dev/null || true
    install -Dm644 usr/share/icons/hicolor/512x512/apps/auralune-desktop.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/auralune.png" 2>/dev/null || true
    install -Dm644 Auralune.png "$pkgdir/usr/share/pixmaps/auralune.png"
}
